# Tuned defaults for a laptop/desktop with a discrete NVIDIA GPU on Windows.
# Reference machine: RTX 5070 Laptop (8 GB, sm_120 Blackwell) + Ryzen 9 8940HX
# (16 cores / 32 threads).  Copy to .env and change the credentials:
#     Copy-Item .env.nvidia.example .env
#
# Requires a CUDA build of torch -- the default install is CPU-only and the app
# will refuse to start with DEVICE=cuda rather than silently falling back:
#     backend\.venv\Scripts\python -m pip install --force-reinstall `
#       torch torchvision --index-url https://download.pytorch.org/whl/cu130
# CUDA 13 (cu130) is not optional on RTX 50-series: those cards are sm_120 and
# the older cu128 and earlier wheels have no kernels for them.
#
# Measure on your own box before trusting any of this:
#   backend\.venv\Scripts\python scripts\benchmark.py `
#     --model data\weights\yolo11m.pt --imgsz 640

# --- Auth (single admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=please-generate-a-long-random-secret

# --- Detection ---
DEVICE=cuda
# yolo11m rather than the yolo11s the CPU profiles use: the GPU has the headroom
# and the bigger model is meaningfully better at the two things that matter here
# -- telling a truck from a bus, and holding small/distant vehicles long enough
# for ByteTrack to keep one identity across the counting line.
YOLO_MODEL=data/weights/yolo11m.pt
INFERENCE_IMGSZ=640
CONF_THRESHOLD=0.35
# fp16. Free on Blackwell's tensor cores and halves the weight/activation
# footprint, which is what keeps several streams inside 8 GB.
INFERENCE_HALF=true
# Every frame. The CPU profiles skip frames because inference is the bottleneck
# there; here it is not, and stride 1 gives the tracker twice as many points to
# associate, which is what makes line counting reliable at speed.
FRAME_STRIDE=1
# Downscale for detection/annotation/streaming. ANPR still crops from the
# full-resolution frame, so plate legibility is unaffected.
PROCESS_WIDTH=1280

# --- Performance ---
# 0 = auto. On CUDA the auto budget is capped at 4 rather than 2: inference no
# longer competes for cores, but resize, letterbox, annotation and JPEG encode
# still run on them and 2 threads makes *those* the bottleneck.
THREADS_PER_WORKER=0
EXPECTED_STREAMS=2
# OFF on purpose. Pinning exists to bound the OpenVINO CPU plugin, whose TBB
# pool ignores the thread-count env vars and only respects the affinity mask.
# A CUDA worker has no such pool, so pinning it to a core slice only slows the
# CPU-side work down.
WORKER_CPU_AFFINITY=off
# Hardware video decoding. Leave this on "auto" (D3D11VA on Windows).
# Do NOT set "cuda": the FFmpeg that ships inside opencv-python has no NVDEC
# decoders built in (no h264_cuvid / hevc_cuvid), so it would fail the open and
# fall back to software -- strictly worse than D3D11VA, which already keeps
# decoding off the CPU cores.
FFMPEG_HWACCEL=auto
RTSP_TRANSPORT_TCP=true

# --- ANPR ---
ALPR_ENABLED=true
# EasyOCR is a torch model (CRAFT + CRNN), so it follows the GPU.
OCR_DEVICE=cuda
# Dedicated plate detector instead of the "bottom 45% of the vehicle box"
# heuristic, which is the single biggest source of misreads. Downloaded by
# scripts/setup_windows.ps1; a YOLO11 fine-tune, so no new dependency.
PLATE_MODEL=data/weights/license-plate-finetune-v1s.pt
# It runs on a vehicle crop, not a full frame -- 320 is plenty.
PLATE_IMGSZ=320
PLATE_CONF_THRESHOLD=0.25
# Drop OCR reads the model was not sure of. A distant or blurry plate still
# produces a string that matches the Indonesian plate pattern -- just the wrong
# one -- and a wrong plate is worse than no plate. Below this the vehicle is
# simply retried on a later frame. Lower it if the camera is close and plates
# are always sharp.
PLATE_MIN_CONFIDENCE=0.20
# Chase each vehicle harder than the CPU profiles do. OCR is cheap here, and
# more attempts means more chances to hit the one frame where the plate is
# square-on and legible.
ALPR_MAX_ATTEMPTS=24
ALPR_ATTEMPT_INTERVAL=2
# Kelas yang platnya dibaca. Motor tidak termasuk secara default: platnya kira-
# kira separuh lebar plat mobil dan dipasang rendah, jadi pada kamera overview
# hasilnya nol sementara jatah OCR-nya tetap terpakai. Tambahkan "motorcycle"
# kalau kamera Anda cukup dekat.
ALPR_CLASSES=car,truck,bus
# Jangan pakai jatah percobaan selama kendaraan masih terlalu kecil untuk
# terbaca. Plat kira-kira seperempat lebar kendaraan, jadi 160 px kendaraan
# ~ 40 px plat. Naikkan sampai hanya kendaraan di bagian frame yang benar-benar
# terbaca yang lolos; turunkan untuk kamera jarak dekat.
ALPR_MIN_VEHICLE_WIDTH=160
# Kendaraan yang berhenti/parkir di zona baca hanya dibaca saat datang, tidak
# terus-menerus. Tracker kehilangan kendaraan yang diam lalu memberinya nomor
# baru, dan tanpa dua setelan ini setiap penomoran ulang jadi baris plat baru.
# Turunkan STATIONARY di kamera portal yang antreannya panjang; naikkan
# PARKED_MEMORY kalau mobil parkir masih lolos sebagai kendaraan baru.
ALPR_STATIONARY_SECONDS=20
ALPR_REID_GAP_SECONDS=4
ALPR_PARKED_MEMORY_SECONDS=300
# Jaring kedua, di level teks: nyalakan (mis. 120) kalau plat yang sama pada
# kamera yang sama dalam rentang itu harus memperbarui baris lama. Mati (0)
# secara default karena ikut menggabungkan kendaraan yang memang lewat dua kali.
ALPR_DUPLICATE_WINDOW_SECONDS=0

# --- Face recognition (YuNet + SFace) ---
FACE_ENABLED=true
FACE_SIMILARITY_THRESHOLD=0.363
# Runs YuNet/SFace on ONNX Runtime, which can use the GPU -- cv2.dnn cannot,
# because the pip build of OpenCV has no CUDA backend. Needs
# backend/requirements-cuda.txt; "auto" falls back to OpenCV when that is not
# installed. One 1280x720 frame with 5 faces: 86.9 ms -> 16.0 ms.
#
# WARNING: the two backends produce different embeddings, so if you already
# have enrolled faces, re-enroll them after changing this.
FACE_BACKEND=auto
# What actually bounds the cost: frames are downscaled to this longest side
# before detection. Lower it (e.g. 640) to trade small/distant faces for speed.
FACE_MAX_SIDE=1024
FACE_DET_SIZE=320

# --- Streaming ---
MJPEG_FPS=25
JPEG_QUALITY=70

# --- Retention ---
RETENTION_DAYS=7
