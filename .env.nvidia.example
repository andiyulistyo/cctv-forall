# Tuned defaults for a laptop/desktop with a discrete NVIDIA GPU on Windows.
# Reference machine: RTX 5070 Laptop (8 GB, sm_120 Blackwell) + Ryzen 9 8940HX
# (16 cores / 32 threads).  Copy to .env and change the credentials:
#     Copy-Item .env.nvidia.example .env
#
# Requires a CUDA build of torch -- the default install is CPU-only and the app
# will refuse to start with DEVICE=cuda rather than silently falling back:
#     backend\.venv\Scripts\python -m pip install --force-reinstall `
#       torch torchvision --index-url https://download.pytorch.org/whl/cu130
# CUDA 13 (cu130) is not optional on RTX 50-series: those cards are sm_120 and
# the older cu128 and earlier wheels have no kernels for them.
#
# Measure on your own box before trusting any of this:
#   backend\.venv\Scripts\python scripts\benchmark.py `
#     --model data\weights\yolo12m.pt --imgsz 640

# --- Auth (single admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=please-generate-a-long-random-secret

# --- Detection ---
DEVICE=cuda
# yolo12m rather than the yolo11s the CPU profiles use: the GPU has the headroom
# and the bigger model is meaningfully better at the two things that matter here
# -- telling a truck from a bus, and holding small/distant vehicles long enough
# for ByteTrack to keep one identity across the counting line.
#
# v12 over v11 is a deliberate trade: its area-attention blocks buy accuracy
# with speed. Measured on this box (RTX 5070 Laptop, fp16, 200 frames):
#
#     yolo11m  imgsz 640  94.5 fps      yolo11m  imgsz 960  74.7 fps
#     yolo12m  imgsz 640  69.3 fps      yolo12m  imgsz 960  66.9 fps
#
# So v12 costs about 27% at the same imgsz. What buys it back is the row above:
# v11 calls that taksi a truck at *every* size tried (0.72-0.83), while v12 at
# 960 gets it right -- and going 640 -> 960 costs v12 only 3.5%, because by then
# the letterbox and NMS on the CPU dominate, not the matmuls.
#
# Only the CUDA profile takes that trade; the CPU and OpenVINO profiles stay on
# v11, where attention is far more expensive. data/weights/yolo11m.pt is still
# on disk if you want it back.
YOLO_MODEL=data/weights/yolo12m.pt
# 960, bukan 640. Pada 640 model ini bimbang antara car dan truck untuk
# kendaraan boxy: satu taksi di gang keluar sebagai truck 0.57 + car 0.48 --
# dua kotak untuk satu benda. Pada 960 jawabannya car 0.90, dan dua salah-kelas
# yang ada di frame bukti lama ikut benar (yang satunya truck 0.83 -> car 0.68);
# tidak ada yang berubah jadi salah. Biayanya kecil karena hambatannya ada di
# sisi CPU (letterbox/NMS), bukan di forward pass: 69.3 fps -> 66.9 fps.
INFERENCE_IMGSZ=960
CONF_THRESHOLD=0.35
# fp16. Free on Blackwell's tensor cores and halves the weight/activation
# footprint, which is what keeps several streams inside 8 GB.
INFERENCE_HALF=true
# Every frame. The CPU profiles skip frames because inference is the bottleneck
# there; here it is not, and stride 1 gives the tracker twice as many points to
# associate, which is what makes line counting reliable at speed.
FRAME_STRIDE=1
# Downscale for detection/annotation/streaming. ANPR still crops from the
# full-resolution frame, so plate legibility is unaffected.
PROCESS_WIDTH=1280

# --- Performance ---
# 0 = auto. On CUDA the auto budget is capped at 4 rather than 2: inference no
# longer competes for cores, but resize, letterbox, annotation and JPEG encode
# still run on them and 2 threads makes *those* the bottleneck.
THREADS_PER_WORKER=0
EXPECTED_STREAMS=2
# OFF on purpose. Pinning exists to bound the OpenVINO CPU plugin, whose TBB
# pool ignores the thread-count env vars and only respects the affinity mask.
# A CUDA worker has no such pool, so pinning it to a core slice only slows the
# CPU-side work down.
WORKER_CPU_AFFINITY=off
# Hardware video decoding. Leave this on "auto" (D3D11VA on Windows).
# Do NOT set "cuda": the FFmpeg that ships inside opencv-python has no NVDEC
# decoders built in (no h264_cuvid / hevc_cuvid), so it would fail the open and
# fall back to software -- strictly worse than D3D11VA, which already keeps
# decoding off the CPU cores.
FFMPEG_HWACCEL=auto
RTSP_TRANSPORT_TCP=true

# --- ANPR ---
ALPR_ENABLED=true
# EasyOCR is a torch model (CRAFT + CRNN), so it follows the GPU.
OCR_DEVICE=cuda
# Dedicated plate detector instead of the "bottom 45% of the vehicle box"
# heuristic, which is the single biggest source of misreads. Downloaded by
# scripts/setup_windows.ps1; a YOLO11 fine-tune, so no new dependency.
PLATE_MODEL=data/weights/license-plate-finetune-v1s.pt
# It runs on a vehicle crop, not a full frame -- 320 is plenty.
PLATE_IMGSZ=320
# A recogniser fine-tuned on YOUR reviewed plates, replacing EasyOCR's generic
# latin CRNN. This is where the review loop closes: correct reads on the Plat
# Nomor page, export the dataset from Akurasi OCR, train, point this at the
# result. Left empty until you have one -- the stock network is what every
# accuracy figure on that page is measured against.
#
# Three files, all sharing the name, or it falls back to stock and says so:
#   <OCR_NETWORK_DIR>/<name>.yaml   <OCR_NETWORK_DIR>/<name>.py
#   <OCR_MODEL_DIR>/<name>.pth
# OCR_MODEL_DIR defaults to data/weights/ocr, and OCR_NETWORK_DIR to whatever
# OCR_MODEL_DIR is -- one folder with three files needs neither line.
# OCR_RECOG_NETWORK=plate_id_v1
# OCR_MODEL_DIR=data/weights/ocr
# OCR_NETWORK_DIR=data/weights/ocr
PLATE_CONF_THRESHOLD=0.25
# Drop OCR reads the model was not sure of. A distant or blurry plate still
# produces a string that matches the Indonesian plate pattern -- just the wrong
# one -- and a wrong plate is worse than no plate. Below this the vehicle is
# simply retried on a later frame. Lower it if the camera is close and plates
# are always sharp.
PLATE_MIN_CONFIDENCE=0.20
# Chase each vehicle harder than the CPU profiles do. OCR is cheap here, and
# more attempts means more chances to hit the one frame where the plate is
# square-on and legible.
ALPR_MAX_ATTEMPTS=24
ALPR_ATTEMPT_INTERVAL=2
# Kumpulkan semua pembacaan satu kendaraan, jangan berhenti di yang pertama
# meyakinkan: tiap pembacaan adalah satu suara, dan yang disimpan adalah hasil
# voting per karakter (lihat app/detection/plate_vote.py). Set false kalau
# kamera terlalu ramai dan antrean OCR mulai membuang crop -- pembacaan pertama
# kendaraan berikutnya lebih berharga daripada pembacaan kesembilan yang ini.
ALPR_READ_ALL_ATTEMPTS=true
# Kelas yang platnya dibaca. Motor tidak termasuk secara default: platnya kira-
# kira separuh lebar plat mobil dan dipasang rendah, jadi pada kamera overview
# hasilnya nol sementara jatah OCR-nya tetap terpakai. Tambahkan "motorcycle"
# kalau kamera Anda cukup dekat.
ALPR_CLASSES=car,truck,bus
# Jangan pakai jatah percobaan selama kendaraan masih terlalu kecil untuk
# terbaca. Plat kira-kira seperempat lebar kendaraan, jadi 160 px kendaraan
# ~ 40 px plat. Naikkan sampai hanya kendaraan di bagian frame yang benar-benar
# terbaca yang lolos; turunkan untuk kamera jarak dekat.
ALPR_MIN_VEHICLE_WIDTH=160
# Kelas yang direkam begitu terlihat DI DALAM zona ANPR, terbaca platnya atau
# tidak. Ini untuk motor: platnya memang jarang terbaca dari kamera overview,
# tapi "platnya tidak terbaca" bukan berarti "tidak ada yang lewat". Yang
# disimpan adalah potongan gambar motornya plus frame penuh, dengan plate_text
# dibiarkan kosong; kalau platnya kemudian terbaca, baris yang sama diisi --
# bukan ditambah baris baru.
#
# car dan truck ikut di sini walaupun keduanya ada di ALPR_CLASSES, dan itu
# memang boleh: kelas yang terdaftar di dua-duanya dapat dua-duanya -- tetap
# dibaca platnya seperti biasa, tapi kalau tidak ada satu pun pembacaan yang
# berhasil, kendaraannya tetap jadi satu baris. Yang mengharuskan ini adalah
# malam hari. Terukur di kamera gang ini: 17 dari 22 mobil terbaca platnya
# siang hari, 0 dari 16 setelah gelap -- padahal mobilnya tetap lewat dan tetap
# terhitung oleh line counter. Tanpa ini, tiap malam mobil hilang sama sekali
# dari daftar. Keluarkan car,truck dari sini kalau Anda hanya mau baris yang
# platnya benar-benar terbaca.
#
# Biayanya baris dan disk, bukan GPU: satu baris + satu crop + satu frame penuh
# (~2 MB kalau ALPR_SAVE_FRAME menyala) per mobil yang lewat, bukan per frame.
#
# Hanya berlaku di dalam zona. Source yang belum digambar zona ANPR-nya tidak
# merekam apa pun (bukan "seluruh frame jadi zona"), dan capture tidak pernah
# menggeser antrean plate read, jadi jatah OCR ALPR_CLASSES di atas tidak
# berkurang sama sekali. Kosongkan untuk mematikan.
# Orang ikut di sini: capture-nya lewat jalur yang sama (zona ANPR, sekali per
# orang), tapi hasilnya ditulis sebagai *face sighting* -- bukan baris plat --
# lengkap dengan nama dari face recognition kalau wajahnya dikenali. Lihat
# halaman Wajah. Orang yang wajahnya tidak menghadap kamera tetap tercatat
# tanpa nama; itu justru yang tidak bisa dilakukan oleh pemindaian wajah
# se-frame, karena wajah yang tidak terdeteksi tidak pernah dicatat.
ALPR_CAPTURE_CLASSES=car,truck,motorcycle,person
# Lebar minimum kotak sebelum di-capture. Sengaja beda dari
# ALPR_MIN_VEHICLE_WIDTH di atas: angka itu soal apakah PLAT bisa terbaca, dan
# 160 px menolak hampir semua motor. Capture cuma perlu memperlihatkan
# kendaraannya, jadi ambangnya jauh lebih rendah. 0 mematikan ambang ini.
# Untuk mobil ambang ini hampir tidak pernah jadi penentu: syarat "seluruh
# kotak ada di dalam zona" sudah lebih dulu menolak mobil yang masih jauh --
# terukur, mobil yang lolos gerbang di kamera ini lebarnya 554-1330 px.
ALPR_CAPTURE_MIN_WIDTH=48
# Baca ulang plat sebuah capture (motor) di beberapa frame berikutnya, bukan
# sekali saja. Satu frame motor bergerak itu lempar koin -- miring, blur, atau
# tertutup kaki pengendara. Percobaan ini hanya diantrekan saat antrean OCR
# benar-benar kosong, jadi tidak pernah mengambil jatah ALPR_CLASSES. 0 =
# kembali ke perilaku satu-tembakan.
ALPR_CAPTURE_READ_ATTEMPTS=8
# Berapa bagian dari kotak kendaraan yang harus berada di dalam zona ANPR
# sebelum dihitung "di dalam zona". Dulu yang diuji cuma satu titik (tengah-
# bawah kotak), dan itu meloloskan kendaraan yang cuma menyerempet tepi zona
# (terukur: 5% dan 19% kotaknya di dalam zona, tetap dibaca) sekaligus menolak
# yang sudah jelas di dalam (96% di dalam zona, ditolak karena rodanya lewat
# sedikit dari batas bawah). 0.5 = minimal separuh kendaraan ada di zona.
ALPR_ZONE_MIN_OVERLAP=0.5
# Berapa bagian kendaraan yang harus berada di dalam zona ANPR sebelum
# di-CAPTURE. Sengaja jauh lebih ketat dari ALPR_ZONE_MIN_OVERLAP di atas,
# karena pertanyaannya beda: pembacaan plat mau frame paling awal yang platnya
# terbaca -- posisi sisa badan kendaraan tidak penting -- sedangkan capture
# adalah catatan "ada kendaraan lewat sini", dan kendaraan yang baru separuh
# masuk zona persis yang tercatat dua kali (sekali saat masuk dengan satu track
# id, sekali lagi sedetik kemudian dengan id lain, saat motornya sudah bergerak
# terlalu jauh untuk dikenali sebagai motor yang sama).
#
# Terukur di rekaman proyek ini: dari 59 baris yang muncul dalam 5 detik dari
# baris sekelas di kamera yang sama, setiap pasangan duplikat punya baris
# pertama 94.8%-98.8% di dalam zona (motor terpotong tepi bawah frame) dan
# baris kedua tepat 100%.
#
# 0.99 = "seluruh badan motor, sisakan satu piksel untuk goyangan deteksi".
# 1.0 menuntut setiap piksel; itu cuma menunda satu-dua frame, karena syarat
# ini diuji ulang di tiap frame selama motor masih di zona. Diturunkan ke arah
# ALPR_ZONE_MIN_OVERLAP, zona kembali jadi "area" dan duplikatnya ikut kembali.
# Konsekuensi menaikkannya: kendaraan yang tidak pernah muat seluruhnya di
# dalam zona tidak akan pernah ter-capture -- jadi gambar zonanya beri ruang
# untuk kendaraan terbesar yang mau dicatat.
ALPR_CAPTURE_CONTAINMENT=0.99
# Berapa lama sebuah capture diingat (detik) untuk dibandingkan dengan capture
# berikutnya dari kelas dan kamera yang sama.
#
# Ini separuh kedua dari penangkal duplikat, dan menangkap yang tidak bisa
# ditangkap aturan zona maupun vehicle registry: satu kendaraan yang dilaporkan
# detektor sebagai DUA kotak bersarang di frame yang SAMA -- motor+pengendara
# sebagai satu kotak, motornya saja sebagai kotak lain. Tidak ada penomoran
# ulang untuk dibatalkan dan tidak ada jeda untuk dikenali; IoU-nya cuma 0.37,
# di bawah ambang registry, padahal satu kotak ada seluruhnya di dalam kotak
# yang lain.
#
# Biarkan pendek. Gunanya menutup satu-dua frame saat satu kendaraan terlapor
# dua kali, bukan mengatur antrean lalu lintas: tiap detiknya adalah detik di
# mana kendaraan lain yang benar-benar beda dan datang di tempat yang sama
# tidak tercatat. 0 mematikan separuh ini dan menyisakan aturan zona saja.
ALPR_CAPTURE_DEDUPE_SECONDS=3.0
# Seberapa besar tumpang tindih sebuah capture baru dengan capture yang
# diingat sebelum dianggap kendaraan yang sama, diukur terhadap kotak yang
# lebih KECIL dari keduanya. Sengaja begitu: kotak bersarang bernilai 1.0 kalau
# diukur begini, dan cuma 0.37 kalau pakai IoU -- itu justru sebabnya registry
# tidak menangkapnya. 0.8 = "salah satu kotak nyaris seluruhnya di dalam yang
# lain". Diturunkan, kendaraan yang cuma berpapasan mulai ikut digabung;
# dinaikkan ke arah 1.0, hanya sarang yang persis yang tertangkap.
ALPR_CAPTURE_DEDUPE_OVERLAP=0.8
# Kendaraan yang berhenti/parkir di zona baca hanya dibaca saat datang, tidak
# terus-menerus. Tracker kehilangan kendaraan yang diam lalu memberinya nomor
# baru, dan tanpa dua setelan ini setiap penomoran ulang jadi baris plat baru.
# Turunkan STATIONARY di kamera portal yang antreannya panjang; naikkan
# PARKED_MEMORY kalau mobil parkir masih lolos sebagai kendaraan baru.
ALPR_STATIONARY_SECONDS=20
ALPR_REID_GAP_SECONDS=4
ALPR_PARKED_MEMORY_SECONDS=300
# Jaring kedua, di level teks: plat yang sama pada kamera yang sama dalam
# rentang ini memperbarui baris lama, bukan menambah baris baru.
#
# Dinyalakan karena jaring pertama (VehicleRegistry) hanya bisa menyatukan
# kendaraan lewat IoU, dan itu gagal pada kendaraan yang bergerak cepat: satu
# taksi yang keluar gang tercatat 3x dalam 7 detik dengan track id 215/220/223
# yang kotaknya sudah tidak beririsan lagi. Ketiganya membaca teks yang sama
# persis, jadi jaring ini yang menangkapnya.
#
# Konsekuensinya kendaraan yang memang lewat dua kali dalam 60 detik di kamera
# yang sama hanya jadi satu baris. Naikkan kalau masih ada duplikat, turunkan
# kalau ada kendaraan bolak-balik yang memang harus tercatat terpisah.
ALPR_DUPLICATE_WINDOW_SECONDS=60

# --- Face recognition (YuNet + SFace) ---
FACE_ENABLED=true
FACE_SIMILARITY_THRESHOLD=0.363
# Runs YuNet/SFace on ONNX Runtime, which can use the GPU -- cv2.dnn cannot,
# because the pip build of OpenCV has no CUDA backend. Needs
# backend/requirements-cuda.txt; "auto" falls back to OpenCV when that is not
# installed. One 1280x720 frame with 5 faces: 86.9 ms -> 16.0 ms.
#
# WARNING: the two backends produce different embeddings, so if you already
# have enrolled faces, re-enroll them after changing this.
FACE_BACKEND=auto
# What actually bounds the cost: frames are downscaled to this longest side
# before detection. Lower it (e.g. 640) to trade small/distant faces for speed.
FACE_MAX_SIDE=1024
FACE_DET_SIZE=320

# --- Streaming ---
MJPEG_FPS=25
JPEG_QUALITY=70
# Gambar box deteksi & wajah hanya yang menyentuh zona ANPR.
#
# Di kamera yang menghadap ke jalan, sebagian besar yang terdeteksi adalah lalu
# lintas yang memang tidak sedang diawasi source ini, dan box-nya jadi isi
# terbanyak layar. Kalau zona sudah digambar, ini menahan overlay di dalamnya:
# box tetap digambar kalau ADA bagian yang menyentuh zona, jadi kendaraan yang
# baru tiba di tepi zona tetap kelihatan -- justru frame itu yang mau dilihat --
# sedangkan yang jelas-jelas di tempat lain tidak.
#
# Ini setelan TAMPILAN saja. Tidak mengubah apa pun soal apa yang dideteksi,
# di-track, dihitung, dibaca, atau di-capture; semuanya tetap satu frame penuh.
# Perlu ditegaskan karena gampang disalahpahami: inference itu langkah yang
# mahal dan jalan di seluruh frame SEBELUM ini, jadi hematnya di sini cuma
# beberapa panggilan gambar kotak OpenCV per frame -- nyata, tapi kecil. Yang
# benar-benar menggeser beban itu FRAME_STRIDE, INFERENCE_IMGSZ, dan ukuran
# YOLO_MODEL. Set false untuk kembali menggambar seluruh frame.
DRAW_ONLY_IN_ZONE=true

# --- Retention ---
RETENTION_DAYS=7
