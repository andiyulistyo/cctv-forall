# Tuned defaults for older Intel Core laptops on Windows.
# Reference machine: Core i7 7th gen (Kaby Lake, 2 cores / 4 threads, HD Graphics).
# Copy to .env and change the credentials:  Copy-Item .env.intel.example .env
#
# This is the tightest of the three profiles. Two CPU cores cannot run YOLO,
# EasyOCR and video decoding at once, so almost everything here trades detail
# for headroom: detection moves to the iGPU, ANPR and face recognition start
# switched off, and the display rate is halved.
#
# No numbers measured on this class of machine yet -- run the benchmark and
# write them here (on a Ryzen 7840U the same yolo11n is ~73 fps INT8, which
# gives you an idea of how much smaller the budget is on two Kaby Lake cores):
#   backend\.venv\Scripts\python scripts\benchmark.py `
#     --model data\weights\yolo11n_openvino_model --imgsz 480

# --- Auth (single admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=please-generate-a-long-random-secret

# --- Detection ---
# OpenVINO GPU plugin = the integrated HD Graphics (Gen9). If /api/health shows
# no "GPU" in openvino_devices, update the Intel Graphics driver -- the plugin
# needs its OpenCL runtime. Set intel:cpu to force the CPU plugin instead.
DEVICE=intel:gpu
# The smallest model, exported FP16 (the iGPU's native precision):
#   python scripts/export_openvino.py --model yolo11n.pt --imgsz 480 --half
YOLO_MODEL=data/weights/yolo11n_openvino_model
# MUST match the --imgsz used for the export: the IR has a fixed input size.
INFERENCE_IMGSZ=480
CONF_THRESHOLD=0.35
# 1 of every 3 frames. Line counting still works; a vehicle crossing at 30 fps
# is seen ~10 times.
FRAME_STRIDE=3
# Meaningless for OpenVINO - precision is baked in at export time.
INFERENCE_HALF=false
# Downscale hard: at imgsz=480 a 1080p frame carries no extra information, and
# resize + JPEG encode are a real cost on two cores.
PROCESS_WIDTH=960

# --- Performance ---
# One stream at a time on this machine. Two is possible if you raise
# FRAME_STRIDE and accept a lower display rate.
THREADS_PER_WORKER=0
EXPECTED_STREAMS=1
WORKER_CPU_AFFINITY=auto
# Quick Sync / D3D11VA fixed-function decoding. This is the single biggest win
# on Kaby Lake: it takes H.264 decoding off the two cores entirely.
FFMPEG_HWACCEL=auto
RTSP_TRANSPORT_TCP=true
# Cap YouTube sources hard - decoding 1080p costs more than the detection.
YOUTUBE_MAX_HEIGHT=480

# --- ANPR ---
# Off by default: EasyOCR is a second neural net on the CPU and will halve the
# frame rate here. Turn it on only if plates matter more than fps, ideally with
# FRAME_STRIDE raised further.
ALPR_ENABLED=false
OCR_DEVICE=cpu

# --- Face recognition (OpenCV YuNet + SFace, CPU) ---
# Also off by default, same reason. If you enable it, keep FACE_DET_SIZE small.
FACE_ENABLED=false
FACE_SIMILARITY_THRESHOLD=0.363
FACE_DET_SIZE=160

# --- Streaming ---
# Lower display rate: every published frame costs a JPEG encode on the CPU.
MJPEG_FPS=12
JPEG_QUALITY=60

# --- Retention ---
RETENTION_DAYS=7
