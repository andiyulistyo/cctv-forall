# Python
__pycache__/
*.pyc
.venv/
venv/

# Data (SQLite DB + plate images + weights)
data/
*.db
*.db-wal
*.db-shm

# Frontend
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# Env — backups too, they hold the same secrets
.env
.env.*
!.env.example
!.env.macos.example
!.env.amd.example
!.env.intel.example

# Editor leftovers. ".env~" and "..env.un~" match none of the patterns above,
# so without these an editor backup of .env is left staged and ready to commit.
*~
.*.un~
*.swp
*.bak
*.orig
