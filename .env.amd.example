# Tuned defaults for AMD Ryzen laptops/mini-PCs on Windows.
# Reference machine: Ryzen 7 PRO 7840U (8 cores / 16 threads, Zen 4, Radeon 780M).
# Copy to .env and change the credentials:  Copy-Item .env.amd.example .env
#
# Why the CPU and not the Radeon iGPU: the OpenVINO GPU plugin is Intel-only,
# and the DirectML route needs a custom ONNX backend that ultralytics does not
# wire up. Zen 4 has AVX-512 with VNNI, so an INT8 model on the OpenVINO CPU
# plugin is the fast, boring, reliable path here.
#
# Measured on a Ryzen 7 PRO 7840U, 1080p input, imgsz=640, detection only,
# single stream with the whole machine available:
#   yolo11n   torch CPU 33 fps | OpenVINO CPU 60 fps | OpenVINO CPU INT8 73 fps
#   yolo11s   torch CPU 17 fps |                     | OpenVINO CPU INT8 44 fps
# Pinned to 2 cores (the 4-stream budget below), yolo11n INT8 still does 55 fps.
# Re-measure on your own box:
#   backend\.venv\Scripts\python scripts\benchmark.py `
#     --model data\weights\yolo11s_int8_openvino_model --imgsz 640

# --- Auth (single admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=please-generate-a-long-random-secret

# --- Detection ---
# OpenVINO CPU plugin. Leave DEVICE empty to auto-detect: an OpenVINO model
# picks the Intel iGPU when there is one, otherwise exactly this.
DEVICE=intel:cpu
# INT8 export from scripts/export_openvino.py --int8. Drop the "_int8" part if
# you exported without quantization.
YOLO_MODEL=data/weights/yolo11s_int8_openvino_model
# MUST match the --imgsz used for the export: the IR has a fixed input size.
INFERENCE_IMGSZ=640
CONF_THRESHOLD=0.35
# Process 1 of every N frames. 2 is plenty for line counting at 25-30 fps.
FRAME_STRIDE=2
# Meaningless for OpenVINO - precision is baked in at export time.
INFERENCE_HALF=false
# Downscale to this width for detection/annotation/streaming. 1280 removes a
# lot of work on 1080p+ cameras; ANPR still crops from the full-res frame.
PROCESS_WIDTH=1280

# --- Performance ---
# CPU threads per worker (0 = auto: physical cores / EXPECTED_STREAMS).
# 8 physical cores / 4 streams = 2 threads each.
THREADS_PER_WORKER=0
EXPECTED_STREAMS=4
# Give each worker its own pair of cores. This is what actually bounds the
# OpenVINO CPU plugin: it schedules on TBB and ignores OMP_NUM_THREADS, but it
# does respect the process affinity mask.
WORKER_CPU_AFFINITY=auto
# Hardware video decoding. "auto" lets OpenCV pick D3D11VA on Windows, which
# uses the Radeon media engine (VCN) and leaves the cores for inference.
FFMPEG_HWACCEL=auto
# RTSP over TCP: far fewer corrupt frames from CCTV than the UDP default.
RTSP_TRANSPORT_TCP=true

# --- ANPR ---
ALPR_ENABLED=true
# EasyOCR is a torch model and stays on the CPU (no CUDA here).
OCR_DEVICE=cpu

# --- Face recognition (OpenCV YuNet + SFace, CPU) ---
FACE_ENABLED=true
FACE_SIMILARITY_THRESHOLD=0.363
FACE_DET_SIZE=320

# --- Streaming ---
# Display frame rate, independent of the detection rate: frames between
# detections are re-drawn with the most recent boxes, so the video stays smooth
# even at FRAME_STRIDE=2.
MJPEG_FPS=25
JPEG_QUALITY=70

# --- Retention ---
RETENTION_DAYS=7
