# Copy to .env and adjust. docker-compose reads these automatically.

# --- Auth (single admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=please-generate-a-long-random-secret

# --- Detection tuning ---
# DEVICE: leave empty for auto (cuda -> mps -> cpu). "mps" = Apple Silicon GPU,
# only available when running natively on macOS (see .env.macos.example).
DEVICE=
# Process 1 of every N frames (higher = lighter CPU load, less temporal detail).
FRAME_STRIDE=2
CONF_THRESHOLD=0.35
# Inference resolution. 640 is the trained size; 480 is faster and less exact.
INFERENCE_IMGSZ=640
# fp16 inference. Only affects GPU devices; benchmark before enabling.
INFERENCE_HALF=false
# Downscale frames to this width for detection/annotation/streaming
# (0 = source resolution). ANPR still crops from the full-resolution frame.
PROCESS_WIDTH=0

# --- Performance ---
# CPU threads per worker process (0 = auto: performance cores / EXPECTED_STREAMS).
# Each source runs in its own process, so an unbounded budget makes them thrash.
THREADS_PER_WORKER=0
# How many sources you plan to run at once (used for the auto thread split).
EXPECTED_STREAMS=4
# FFmpeg hardware decoder: "videotoolbox" (macOS), "cuda" (NVIDIA), empty =
# software. Falls back to software automatically if a stream refuses it.
FFMPEG_HWACCEL=
# Force RTSP over TCP — far fewer corrupt frames from CCTV than UDP.
RTSP_TRANSPORT_TCP=true
# Enable/disable Automatic Number Plate Recognition globally.
ALPR_ENABLED=true
# Device for EasyOCR (empty = follow the detector, except MPS which stays CPU).
OCR_DEVICE=

# --- Face recognition (OpenCV YuNet + SFace) ---
# Global on/off; per-source toggle is set when adding a source.
FACE_ENABLED=true
# Cosine similarity threshold (higher = stricter). SFace default ~0.363.
FACE_SIMILARITY_THRESHOLD=0.363

# --- Retention ---
RETENTION_DAYS=7
