# Copy to .env and adjust. docker-compose reads these automatically.

# --- Auth (single admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=please-generate-a-long-random-secret

# --- Detection tuning ---
# DEVICE: leave empty for auto (cpu on the CPU image, cuda on the GPU image).
DEVICE=
# Process 1 of every N frames (higher = lighter CPU load, less temporal detail).
FRAME_STRIDE=2
CONF_THRESHOLD=0.35
# Enable/disable Automatic Number Plate Recognition globally.
ALPR_ENABLED=true

# --- Retention ---
RETENTION_DAYS=7
