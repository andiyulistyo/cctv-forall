# Tuned defaults for Apple Silicon (Mac mini M4 / M4 Pro).
# Copy to .env and change the credentials:  cp .env.macos.example .env
#
# Numbers below were measured on a Mac mini M4 Pro (12-core: 8P + 4E),
# yolo11n, 1080p input, detection only:
#   CPU 40 fps | GPU (mps) 108 fps | Neural Engine (CoreML) 113 fps

# --- Auth (single admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=please-generate-a-long-random-secret

# --- Detection ---
# mps = Apple GPU (Metal). Leave empty to auto-detect (cuda -> mps -> cpu).
DEVICE=mps
# The M4 Pro runs yolo11s at ~90 fps, so prefer it over yolo11n for accuracy.
# For the Neural Engine instead: run scripts/export_coreml.py and point this at
# data/weights/yolo11s.mlpackage (INFERENCE_IMGSZ must match the export).
YOLO_MODEL=data/weights/yolo11s.pt
INFERENCE_IMGSZ=640
CONF_THRESHOLD=0.35
# Process 1 of every N frames. 2 is plenty for line counting at 25-30 fps.
FRAME_STRIDE=2
# fp16: measured as a wash on M-series (faster for yolo11n, slower for
# yolo11s). Benchmark before turning it on.
INFERENCE_HALF=false
# Downscale to this width for detection/annotation/streaming. 1280 removes a
# lot of work on 1080p+ cameras; ANPR still crops from the full-res frame.
PROCESS_WIDTH=1280

# --- Performance ---
# CPU threads per worker process (0 = auto: performance cores / EXPECTED_STREAMS).
THREADS_PER_WORKER=0
# How many sources you plan to run at once — used for the auto thread split.
EXPECTED_STREAMS=4
# Hardware video decoding on the Apple media engine. Big win with several
# 1080p streams; falls back to software automatically if a stream refuses it.
FFMPEG_HWACCEL=videotoolbox
# RTSP over TCP: far fewer corrupt frames from CCTV than the UDP default.
RTSP_TRANSPORT_TCP=true

# --- ANPR ---
ALPR_ENABLED=true
# EasyOCR stays on the CPU: its model is small, some ops fall back anyway, and
# it would otherwise contend with YOLO for the GPU.
OCR_DEVICE=cpu

# --- Face recognition (OpenCV YuNet + SFace, CPU) ---
FACE_ENABLED=true
FACE_SIMILARITY_THRESHOLD=0.363
FACE_DET_SIZE=320

# --- Streaming ---
# Display frame rate, independent of the detection rate: frames between
# detections are re-drawn with the most recent boxes, so the video stays smooth
# even at FRAME_STRIDE=2. Set it at or above the camera's frame rate for smooth
# video; lower it (15, 10) to save CPU when many tiles are open at once.
MJPEG_FPS=30
JPEG_QUALITY=70

# --- Retention ---
RETENTION_DAYS=7
